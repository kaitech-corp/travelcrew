rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function belongsTo(userId) {
      return signedIn() && uid() == userId;
    }

    function tripRef(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function tripData(tripId) {
      return get(tripRef(tripId)).data;
    }

    function isTripOwnerForData(data) {
      return signedIn() && data.createdBy == uid();
    }

    function isTripMemberForData(data) {
      return signedIn() &&
        (data.createdBy == uid() ||
         uid() in (data.joinedUsers == null ? [] : data.joinedUsers));
    }

    function canReadTripData(data) {
      return isAdmin() ||
        (signedIn() &&
         (data.isPrivate != true || isTripMemberForData(data)));
    }

    function canWriteTripData(data) {
      return isAdmin() || isTripOwnerForData(data);
    }

    function canReadTripId(tripId) {
      return exists(tripRef(tripId)) && canReadTripData(tripData(tripId));
    }

    function canWriteTripId(tripId) {
      return exists(tripRef(tripId)) && canWriteTripData(tripData(tripId));
    }

    match /users/{userId} {
      allow read, update, delete: if belongsTo(userId) || isAdmin();
      allow create: if belongsTo(userId) || isAdmin();
    }

    match /settings/{userId} {
      allow read, write: if belongsTo(userId) || isAdmin();
    }

    match /publicProfile/{userId} {
      allow read: if signedIn();
      allow create: if belongsTo(userId) || isAdmin();
      allow delete: if belongsTo(userId) || isAdmin();
      allow update: if belongsTo(userId) ||
        isAdmin() ||
        (signedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']) &&
         (request.resource.data.followers.toSet().difference(resource.data.followers.toSet()) == [uid()].toSet() ||
          resource.data.followers.toSet().difference(request.resource.data.followers.toSet()) == [uid()].toSet()));
    }

    match /trips/{tripId} {
      allow read: if canReadTripData(resource.data);
      allow create: if signedIn() &&
        request.resource.data.createdBy == uid() &&
        request.resource.data.id == tripId;
      allow update: if canWriteTripData(resource.data) &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if canWriteTripData(resource.data);

      match /Members/{memberId} {
        allow read: if canReadTripId(tripId);
        allow create, update, delete: if canWriteTripId(tripId) || belongsTo(memberId);
      }
    }

    match /expense/{expenseId} {
      allow read: if canReadTripId(resource.data.tripId);
      allow create: if signedIn() &&
        request.resource.data.createdBy == uid() &&
        canReadTripId(request.resource.data.tripId);
      allow update, delete: if signedIn() &&
        (resource.data.createdBy == uid() || canWriteTripId(resource.data.tripId));
    }

    match /activity/{activityId} {
      allow read: if canReadTripId(resource.data.tripId);
      allow create: if signedIn() &&
        request.resource.data.tripId is string &&
        canReadTripId(request.resource.data.tripId);
      allow update: if signedIn() && canReadTripId(resource.data.tripId);
      allow delete: if signedIn() &&
        (canWriteTripId(resource.data.tripId) || resource.data.createdBy == uid());
    }

    match /flights/{flightId} {
      allow read: if canReadTripId(resource.data.tripId);
      allow create: if signedIn() && canReadTripId(request.resource.data.tripId);
      allow update, delete: if signedIn() &&
        (resource.data.createdBy == uid() || canWriteTripId(resource.data.tripId));
    }

    match /chat/{roomId} {
      allow read, update, delete: if signedIn() && uid() in resource.data.usersIds;
      allow create: if signedIn() && uid() in request.resource.data.usersIds;

      match /messages/{messageId} {
        allow read: if signedIn() && uid() in get(/databases/$(database)/documents/chat/$(roomId)).data.usersIds;
        allow create: if signedIn() &&
          uid() in get(/databases/$(database)/documents/chat/$(roomId)).data.usersIds &&
          request.resource.data.createdBy == uid();
        allow update, delete: if signedIn() && resource.data.createdBy == uid();
      }
    }

    match /notifications/{userId}/notification/{notificationId} {
      allow read, update, delete: if belongsTo(userId) || isAdmin();
      allow create: if signedIn() &&
        (request.resource.data.createdBy == uid() || belongsTo(userId) || isAdmin());
    }

    match /tokens/{userId}/tokens/{tokenId} {
      allow read: if belongsTo(userId) || isAdmin();
      allow write: if belongsTo(userId) || isAdmin();
    }

    match /mail/{document=**} {
      allow read, write: if isAdmin();
    }

    match /apiKeys/{document=**} {
      allow read, write: if isAdmin();
    }

    match /feedback/{document} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /reports/{document=**} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
