rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/safetyAccounts/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/safetyAccounts/$(request.auth.uid)).data.restricted != true);
    }

    function noBlock(a, b) {
      return !exists(/databases/$(database)/documents/users/$(a)/blockedUsers/$(b)) &&
        !exists(/databases/$(database)/documents/users/$(b)/blockedUsers/$(a));
    }

    function notRemoved(data) {
      return data.get('moderationRemoved', false) != true;
    }

    function unchangedModeration() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderationRemoved']);
    }

    function joinedIds(data) {
      return data.get('joinedUsers', null) == null ? [] : data.joinedUsers;
    }

    function noNewMembers() {
      return joinedIds(request.resource.data).toSet()
        .difference(joinedIds(resource.data).toSet()).size() == 0;
    }

    function validChatMembership(roomId) {
      return request.resource.data.usersIds.toSet().difference(
        joinedIds(tripData(roomId)).toSet().union([tripData(roomId).createdBy].toSet())
      ).size() == 0 && isTripMember(roomId);
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function belongsTo(userId) {
      return signedIn() && uid() == userId;
    }

    function tripRef(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function tripMemberRef(tripId, userId) {
      return /databases/$(database)/documents/trips/$(tripId)/members/$(userId);
    }

    function tripMemberData(tripId, userId) {
      return get(tripMemberRef(tripId, userId)).data;
    }

    function tripData(tripId) {
      return get(tripRef(tripId)).data;
    }

    function isTripOwnerForData(data) {
      return signedIn() && data.createdBy == uid();
    }

    function isTripMemberForData(data) {
      return signedIn() &&
        (data.createdBy == uid() ||
         uid() in (data.joinedUsers == null ? [] : data.joinedUsers));
    }

    function isTripMember(tripId) {
      return signedIn() &&
        ((exists(tripMemberRef(tripId, uid())) &&
          tripMemberData(tripId, uid()).status == 'active') ||
         (exists(tripRef(tripId)) && isTripMemberForData(tripData(tripId))));
    }

    function isTripOwner(tripId) {
      return signedIn() &&
        exists(tripRef(tripId)) &&
        tripData(tripId).createdBy == uid();
    }

    function isSharedTrip(tripId) {
      return exists(tripRef(tripId)) &&
        tripData(tripId).isShared == true;
    }

    function canReadTripData(data) {
      return isAdmin() || data.isShared == true || isTripMemberForData(data);
    }

    function canWriteTripData(data) {
      return isAdmin() || (isTripOwnerForData(data) && notRemoved(data));
    }

    function onlyFavouriteCountChanged() {
      return signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favouriteCount']);
    }

    function onlyDiscoveryMemberCountDecremented() {
      return signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberCount',
          'updatedAt'
        ]) &&
        request.resource.data.memberCount == resource.data.memberCount - 1 &&
        request.resource.data.memberCount >= 0;
    }

    function onlySelfRemovedFromJoinedUsers() {
      return signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedUsers']) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        uid() in (resource.data.joinedUsers == null ? [] : resource.data.joinedUsers) &&
        !(uid() in (request.resource.data.joinedUsers == null ? [] : request.resource.data.joinedUsers)) &&
        (request.resource.data.joinedUsers == null ? [] : request.resource.data.joinedUsers).toSet()
          .difference((resource.data.joinedUsers == null ? [] : resource.data.joinedUsers).toSet()) == [].toSet() &&
        (resource.data.joinedUsers == null ? [] : resource.data.joinedUsers).toSet()
          .difference((request.resource.data.joinedUsers == null ? [] : request.resource.data.joinedUsers).toSet()) == [uid()].toSet();
    }

    function onlyChatMembershipChanged() {
      return signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'usersIds',
          'updatedAt'
        ]);
    }

    function publicProfileOwnerFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'profileImage',
        'email'
      ]);
    }

    function publicProfileCreateFieldsValid(userId) {
      return request.resource.data.uid == userId &&
        request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'facebookLink',
          'firstName',
          'hometown',
          'instagramLink',
          'lastName',
          'followers',
          'following',
          'topDestinations',
          'tripsCreated',
          'tripsJoined',
          'uid',
          'profileImage',
          'favouriteTrips'
        ]) &&
        request.resource.data.followers.size() == 0 &&
        request.resource.data.following.size() == 0 &&
        request.resource.data.tripsCreated == 0 &&
        request.resource.data.tripsJoined == 0;
    }

    function canReadTripId(tripId) {
      return exists(tripRef(tripId)) && canReadTripData(tripData(tripId));
    }

    function canWriteTripId(tripId) {
      return exists(tripRef(tripId)) && canWriteTripData(tripData(tripId));
    }

    match /users/{userId} {
      allow read, update, delete: if belongsTo(userId) || isAdmin();
      allow create: if belongsTo(userId) || isAdmin();

      match /chatActivity/{roomId} {
        allow read: if belongsTo(userId);
        allow create: if belongsTo(userId) && isTripMember(roomId) &&
          request.resource.data.keys().hasOnly(['readAt']) &&
          request.resource.data.readAt == request.time;
        allow update: if belongsTo(userId) && isTripMember(roomId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
          request.resource.data.readAt == request.time;
        allow delete: if false;
      }

      match /blockedUsers/{targetId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /tripMemberships/{tripId} {
        allow read: if belongsTo(userId) || isAdmin();
        allow create: if isAdmin() || (belongsTo(userId) &&
          getAfter(tripRef(tripId)).data.createdBy == userId && request.resource.data.role == 'creator');
        allow update, delete: if isAdmin() || belongsTo(userId) || isTripOwner(tripId);
      }
    }

    match /settings/{userId} {
      allow read, write: if belongsTo(userId) || isAdmin();
    }

    match /publicProfile/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin() ||
        (belongsTo(userId) && publicProfileCreateFieldsValid(userId));
      allow delete: if isAdmin() || (belongsTo(userId) && notRemoved(resource.data));
      allow update: if isAdmin() || (belongsTo(userId) && notRemoved(resource.data) && publicProfileOwnerFieldsOnly());
    }

    match /tripDiscovery/{tripId} {
      allow read: if signedIn() && resource.data.isDiscoverable == true;
      allow create, update: if signedIn() &&
        request.resource.data.createdBy == uid() &&
        notRemoved(getAfter(tripRef(tripId)).data) &&
        request.resource.data.id == tripId &&
        request.resource.data.keys().hasOnly([
          'id',
          'title',
          'destination',
          'country',
          'continent',
          'latitude',
          'longitude',
          'tripStartDate',
          'tripEndDate',
          'startDate',
          'endDate',
          'images',
          'memberCount',
          'favouriteCount',
          'createdBy',
          'creatorDisplayName',
          'creatorProfileImage',
          'tripStatus',
          'isDiscoverable',
          'updatedAt'
        ]);
      allow update: if onlyFavouriteCountChanged();
      allow update: if isTripMember(tripId) && onlyDiscoveryMemberCountDecremented();
      // Authorize cleanup even when the discovery document is already absent.
      allow delete: if isTripOwner(tripId);
    }

    match /trips/{tripId} {
      allow read: if canReadTripData(resource.data);
      allow create: if signedIn() &&
        request.resource.data.createdBy == uid() &&
        request.resource.data.id == tripId &&
        !request.resource.data.keys().hasAny(['moderationRemoved']) &&
        joinedIds(request.resource.data).toSet().difference([uid()].toSet()).size() == 0;
      allow update: if canWriteTripData(resource.data) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        unchangedModeration() && noNewMembers();
      allow update: if onlySelfRemovedFromJoinedUsers();
      allow update: if onlyFavouriteCountChanged();
      allow delete: if canWriteTripData(resource.data);

      match /Members/{memberId} {
        allow read: if canReadTripId(tripId);
        allow write: if isAdmin();
      }

      match /members/{memberId} {
        allow read: if isAdmin() || isSharedTrip(tripId) || isTripMember(tripId);
        allow create: if isAdmin() || (belongsTo(memberId) &&
          getAfter(tripRef(tripId)).data.createdBy == memberId &&
          request.resource.data.userId == memberId && request.resource.data.role == 'creator');
        allow update: if isAdmin() || ((isTripOwner(tripId) || belongsTo(memberId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'removedAt']) &&
          request.resource.data.status == 'left');
        allow delete: if isAdmin() || isTripOwner(tripId) || belongsTo(memberId);
      }

      match /joinRequests/{userId} {
        allow read: if isAdmin() || isTripOwner(tripId) || belongsTo(userId);
        // Lifecycle transitions and their inbox events commit together on the server.
        allow write: if false;
      }

      match /activities/{activityId} {
        allow read: if isAdmin() || isSharedTrip(tripId) || isTripMember(tripId);
        allow create, update: if isAdmin() || isTripMember(tripId);
        allow delete: if isAdmin() || isTripOwner(tripId) || resource.data.createdBy == uid();
      }

      match /expenses/{expenseId} {
        allow read: if isAdmin() || isTripMember(tripId);
        allow create: if signedIn() &&
          request.resource.data.createdBy == uid() &&
          isTripMember(tripId);
        allow update, delete: if isAdmin() || isTripOwner(tripId) || resource.data.createdBy == uid();
      }

      match /flights/{flightId} {
        allow read: if isAdmin() || isSharedTrip(tripId) || isTripMember(tripId);
        allow create: if signedIn() &&
          request.resource.data.userId == uid() &&
          isTripMember(tripId);
        allow update, delete: if isAdmin() || isTripOwner(tripId) || resource.data.userId == uid();
      }
    }

    match /expense/{expenseId} {
      allow read: if isAdmin() || isTripMember(resource.data.tripId);
      allow create: if signedIn() &&
        request.resource.data.createdBy == uid() &&
        isTripMember(request.resource.data.tripId);
      allow update, delete: if signedIn() &&
        (resource.data.createdBy == uid() || isTripOwner(resource.data.tripId));
    }

    match /activity/{activityId} {
      allow read: if isAdmin() || isSharedTrip(resource.data.tripId) || isTripMember(resource.data.tripId);
      allow create: if signedIn() &&
        request.resource.data.tripId is string &&
        isTripMember(request.resource.data.tripId);
      allow update: if signedIn() && isTripMember(resource.data.tripId);
      allow delete: if signedIn() &&
        (isTripOwner(resource.data.tripId) || resource.data.createdBy == uid());
    }

    match /flights/{flightId} {
      allow read: if isAdmin() || isSharedTrip(resource.data.tripId) || isTripMember(resource.data.tripId);
      allow create: if signedIn() && isTripMember(request.resource.data.tripId);
      allow update, delete: if signedIn() &&
        (resource.data.userId == uid() || isTripOwner(resource.data.tripId));
    }

    match /chat/{roomId} {
      allow read: if signedIn() && uid() in resource.data.usersIds;
      allow create: if signedIn() && validChatMembership(roomId);
      allow update: if signedIn() && validChatMembership(roomId) &&
        (uid() in resource.data.usersIds || isTripOwner(roomId));
      allow delete: if isAdmin() || isTripOwner(roomId);

      match /messages/{messageId} {
        allow read: if signedIn() && uid() in get(/databases/$(database)/documents/chat/$(roomId)).data.usersIds;
        allow create: if signedIn() && isTripMember(roomId) &&
          uid() in get(/databases/$(database)/documents/chat/$(roomId)).data.usersIds &&
          request.resource.data.createdBy == uid() && !request.resource.data.keys().hasAny(['moderationRemoved']);
        allow update: if signedIn() && resource.data.createdBy == uid() &&
          notRemoved(resource.data) && unchangedModeration() &&
          request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if signedIn() && resource.data.createdBy == uid() && notRemoved(resource.data);
      }
    }

    match /notifications/{userId}/notification/{notificationId} {
      allow read: if belongsTo(userId) || isAdmin();
      allow create, delete: if false;
      allow update: if belongsTo(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notificationStatus', 'isActive']) &&
        request.resource.data.notificationStatus in ['read', 'unread'] &&
        request.resource.data.isActive is bool;
    }

    match /tokens/{userId}/tokens/{tokenId} {
      allow read: if belongsTo(userId) || isAdmin();
      allow write: if belongsTo(userId) || isAdmin();
    }

    match /mail/{document=**} {
      allow read, write: if isAdmin();
    }

    match /apiKeys/{document=**} {
      allow read, write: if isAdmin();
    }

    match /feedback/{document} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /reports/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-owned safety metadata and audit history cannot be mutated by clients,
    // including moderator clients. Moderation mutations go through the callable.
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
